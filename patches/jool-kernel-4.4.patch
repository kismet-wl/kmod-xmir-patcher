diff --git a/src/mod/common/jool_netns.h b/src/mod/common/jool_netns.h
new file mode 100644
index 0000000..ffb4ee7
--- /dev/null
+++ b/src/mod/common/jool_netns.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Jool Network Namespace Compatibility Layer
+ *
+ * Provides compatibility for kernels without CONFIG_NET_NS support.
+ * When CONFIG_NET_NS is disabled, get_net_ns_by_pid() and put_net()
+ * are not exported, so we provide stub implementations.
+ */
+
+#ifndef _JOOL_NETNS_H
+#define _JOOL_NETNS_H
+
+#include <linux/net_namespace.h>
+#include <linux/sched.h>
+
+/*
+ * When CONFIG_NET_NS is disabled:
+ * - There is only one network namespace (init_net)
+ * - get_net_ns_by_pid() is not exported
+ * - put_net() is not exported (no refcounting needed for init_net)
+ */
+#ifdef CONFIG_NET_NS
+
+static inline struct net *jool_get_net_ns(void)
+{
+	return get_net_ns_by_pid(task_pid_vnr(current));
+}
+
+static inline void jool_put_net(struct net *ns)
+{
+	put_net(ns);
+}
+
+#else /* !CONFIG_NET_NS */
+
+static inline struct net *jool_get_net_ns(void)
+{
+	return &init_net;
+}
+
+static inline void jool_put_net(struct net *ns)
+{
+	/* No-op: init_net doesn't need refcounting */
+}
+
+#endif /* CONFIG_NET_NS */
+
+#endif /* _JOOL_NETNS_H */
